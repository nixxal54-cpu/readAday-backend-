# ==============================================================================
# readAday Backend - Environment Variables Configuration
# ==============================================================================

# Server Configuration
PORT=3000
NODE_ENV=production
CORS_ORIGIN=*

# Supabase Project Credentials (from Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL="https://xyzcompany.supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# PostgreSQL Direct Connection String (from Supabase -> Project Settings -> Database)
# Used for Drizzle Kit or direct connection pooling if needed
DATABASE_URL="postgresql://postgres.your-ref:your-password@aws-0-region.pooler.supabase.com:6543/postgres"

# Background Worker & Cron Authentication Secret
CRON_SECRET="your-secure-random-secret-for-webhook-triggers"

# AI & Semantic Embeddings (Optional for vector discovery)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Public App / Deployment URL (e.g. https://readaday-backend.onrender.com)
APP_URL="MY_APP_URL"

# ==============================================================================
# Content Providers (10 Real Integrations)
# Note: Most providers support open/public discovery out-of-the-box.
# Optional keys provide higher rate limits, authenticated publications, and full archives.
# ==============================================================================

# 1. The Guardian API (https://open-platform.theguardian.com/access/)
# If omitted, gracefully falls back to Guardian open publication wire feeds.
GUARDIAN_API_KEY=""

# 2. Blogger API v3 (https://console.cloud.google.com/apis/library/blogger.googleapis.com)
# If omitted, uses public RSS/JSON feeds from Google Research and verified publications.
BLOGGER_API_KEY=""
BLOGGER_BLOG_ID=""

# 3. Hashnode Developer Platform (https://hashnode.com/settings/developer)
# Optional Personal Access Token for higher rate limits on GraphQL publication feeds.
HASHNODE_API_KEY=""

# 4. DEV.to API (https://dev.to/settings/extensions)
# Optional API key for DEV Community querying. Free read access works without key.
DEVTO_API_KEY=""

# 5. OpenAlex Scholarly Index (https://openalex.org)
# Optional API key for increased daily budget.
OPENALEX_API_KEY=""

# 6. GDELT Project 2.0 (Open global event database, no key required)
# 7. RSS Publication Engine (Direct XML parsing, no key required)
# 8. arXiv Scientific Repository (Open-access preprints, no key required)
# 9. Gutendex Project Gutenberg (Public-domain literature catalog, no key required)
# 10. Wikipedia Knowledge Graph (MediaWiki Open API, no key required)

